# Copy to .env and edit. Every setting is optional; these are the defaults.

LLMFIT_DATABASE_URL=postgresql+psycopg://llmfit:llmfit@localhost:5432/llmfit

# "fixture" reads the saved example pages and needs no browser.
# "crawl4ai" fetches the real URLs. Needs requirements-crawler.txt.
LLMFIT_CRAWLER=fixture
LLMFIT_FIXTURE_DIR=tests/fixtures/pages
LLMFIT_MAX_PAGE_BYTES=524288
LLMFIT_CRAWL_TIMEOUT_SECONDS=30

# Only turn this on to crawl a server on your own machine. It switches off the
# check that stops the crawler reaching internal addresses.
LLMFIT_ALLOW_PRIVATE_ADDRESSES=false

# Used by the tests.
LLMFIT_TEST_DATABASE_URL=postgresql+psycopg://llmfit:llmfit@localhost:5432/llmfit_test
