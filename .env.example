# Copy to .env for local development. Never commit real secrets (guide section 11).

LLMFIT_ENVIRONMENT=development

# Runtime role: not the table owner, not a superuser, not BYPASSRLS.
LLMFIT_DATABASE_URL=postgresql+psycopg://llmfit_app:llmfit_app@localhost:5432/llmfit
# Migration credentials are deliberately separate.
LLMFIT_MIGRATION_DATABASE_URL=postgresql+psycopg://llmfit_migrate:llmfit_migrate@localhost:5432/llmfit

LLMFIT_SESSION_TTL_SECONDS=43200

# "fixture" reads saved pages from disk; "crawl4ai" drives a real browser.
LLMFIT_CRAWL_BACKEND=fixture
LLMFIT_CRAWL_FIXTURE_DIR=tests/fixtures/pages
LLMFIT_CRAWL_BROWSER_CONCURRENCY=2
LLMFIT_CRAWL_PER_DOMAIN_MIN_INTERVAL_SECONDS=2.0
LLMFIT_CRAWL_MAX_PAGE_BYTES=524288
LLMFIT_CRAWL_LEASE_SECONDS=300
# Leave false outside a local fixture server; true disables egress protection.
LLMFIT_CRAWL_ALLOW_PRIVATE_DESTINATIONS=false

LLMFIT_PRICE_FRESHNESS_DAYS=7
LLMFIT_SPEC_FRESHNESS_DAYS=30

# Test database, used by the integration and contract suites.
LLMFIT_TEST_DATABASE_URL=postgresql+psycopg://llmfit_app:llmfit_app@localhost:5432/llmfit_test
LLMFIT_TEST_MIGRATION_DATABASE_URL=postgresql+psycopg://llmfit_migrate:llmfit_migrate@localhost:5432/llmfit_test
